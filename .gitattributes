# Normalisation des fins de ligne : LF dans le dépôt et la copie de travail
* text=auto eol=lf

# Fichiers binaires — jamais de conversion de fin de ligne
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pbix  binary
*.xlsx  binary
*.ico   binary

# Notebooks : JSON, garder octet-stable (pas de normalisation)
*.ipynb -text

# Données : préserver l'encodage (BOM) tel quel
*.csv   -text
